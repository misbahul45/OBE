{
	"name": "obe-tb",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"guard": "bun run scripts/guard.ts",
		"track": "bun run scripts/track.ts",
		"docs:status": "bun run scripts/track.ts status",
		"docs:check": "bun run scripts/track.ts check && bun run scripts/guard.ts",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait postgres",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
		"db:psql": "docker compose -f docker-compose.dev.yml exec postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
		"db:status": "docker compose -f docker-compose.dev.yml ps && docker compose -f docker-compose.dev.yml exec -T postgres pg_isready -U obe -d obe_dev",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:test:reset": "bun --env-file=.env.test run scripts/db.ts test-reset",
		"db:test:template": "bun --env-file=.env.test run scripts/db.ts test-template",
		"seed:superadmin": "bun run scripts/seed-superadmin.ts",
		"seed:demo": "bun run scripts/seed-demo.ts",
		"seed:curriculum": "bun run scripts/seed-curriculum.ts",
		"seed:lecturers": "bun run scripts/seed-lecturers.ts",
		"import:semesters": "bun run scripts/import-semesters.ts",
		"auth:schema": "auth generate --config scripts/auth-cli.ts --output src/lib/features/auth/auth.schema.ts --yes && bun run scripts/guard.ts comments --fix",
		"fixtures:build": "bun run tests/fixtures/builders/build-workbooks.ts",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun run db:test:template && bun test tests/integration",
		"test:local": "bun test tests/local",
		"test:feature": "bun run scripts/test-feature.ts",
		"test:e2e": "playwright test",
		"test:all": "bun run test && bun run test:e2e"
	},
	"type": "module",
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^24",
		"@types/pdfkit": "^0.17.7",
		"@types/three": "^0.186.0",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@sveltejs/adapter-vercel": "^7.0.1",
		"gsap": "^3.15.0",
		"pdfkit": "^0.20.2",
		"three": "^0.186.1",
		"uploadthing": "^7.7.4",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.6.7"
	}
}
